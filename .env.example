# Copy this file to .env and fill in the values. Never share or commit .env.

# Which AI engine to use:
#   api          - the Claude API (production, pay as you go). Needs ANTHROPIC_API_KEY. Billed per use.
#   claude-code  - local test engine on your own Claude subscription via Claude Code. Free for you, but ONLY
#                  for your own testing on this computer: never for real clients or other people.
AI_ENGINE=api
# Optional for the test engine: CLAUDE_CODE_PATH (auto-detected), CLAUDE_CODE_MODEL (default: claude-opus-5-5).

# Claude API key from https://console.anthropic.com (Settings > API keys). Billed per use.
ANTHROPIC_API_KEY=

# Admin dashboard at /admin. Only ADMIN_EMAIL can sign in (default: NOTIFY_EMAIL). Set the password by
# double-clicking set-admin-password.bat: it saves only a hash of it here as ADMIN_PASSWORD_HASH.
# ADMIN_EMAIL=practice@example.com
ADMIN_PASSWORD_HASH=

# Card payments with Stripe (https://dashboard.stripe.com > Developers > API keys). While testing use the test
# keys (sk_test_...): Stripe's test cards work and no money moves. STRIPE_WEBHOOK_SECRET (whsec_...) comes from
# Developers > Webhooks, for the endpoint https://<your app address>/api/stripe/webhook, event
# checkout.session.completed.
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Hypnotherapist requests are emailed here, through the practice's own mailbox (SMTP). Until SMTP_HOST is set,
# each request is saved to data\outbox as an .eml file instead (open it with any mail program).
# NOTIFY_EMAIL=practice@example.com
# SMTP_HOST=
# SMTP_PORT=587            (465 for SSL)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# PUBLIC_URL=http://127.0.0.1:8000   (links in emails point here; clients' private links too)

# Clients' emails: a receipt (with their private link back to their session and the words they agreed about
# cancelling), "your session is ready", reminders about an undecided preview, and a follow-up. UK receipts must
# name the seller and give a postal address.
# PRACTICE_NAME=Example Practice
# PRACTICE_ADDRESS=
# PREVIEW_REMINDER_DAYS=1,6   (days after the preview; only to clients who did not opt out)
# FOLLOW_UP_DAYS=10           ("how are you doing?" after the full session is ready)

# Showing the app inside the practice's website page (optional). EMBED_ORIGINS: the websites allowed to show it
# (comma separated; the admin pages are never shown elsewhere). CLIENT_PAGE_URL: that page, so clients' links and the
# return from payment lead there. The website's <iframe> must allow the microphone and sound, or spoken answers are
# refused by the browser, and both sites must be https:
#   <iframe src="https://<your app address>/" allow="microphone; autoplay"></iframe>
# EMBED_ORIGINS=https://www.example.com
# CLIENT_PAGE_URL=https://www.example.com/ai-hypnotherapist

# Optional settings (defaults shown).
# CLAUDE_MODEL=claude-opus-5-5
# KNOWLEDGE_ROOT=./knowledge
# DATA_DIR=data             (sessions, audio, the outbox and logs; inside the app's folder by default)
# REQUIRE_CLINICIAN_REVIEW=false
# CONSULTATION_PRICE_GBP=5
# AI_SESSION_PRICE_GBP=35
# HUMAN_SESSION_PRICE_FROM_GBP=199
# HUMAN_SESSION_PRICE_TO_GBP=299
# PAYMENT_PROVIDER=test    (a clearly marked test checkout, no money moves; "stripe" for card payments, above)
# AUDIO_RETENTION_DAYS=7   (every session's audio is deleted this many days after it was made)
# CONSULTATION_MINUTES=20
# LANGUAGES=en,de,fr,es    (the languages clients can choose; English is always included. The qualified
#                           hypnotherapist is offered in English only, and the app says so in the other languages)
# BOOKS_MODEL=claude-haiku-4-5  (reads the books added in the admin panel: about 4 times cheaper than CLAUDE_MODEL)
# TRANSCRIBE_MULTILINGUAL_MODEL=small  (speech to text for German, French and Spanish answers; about 480 MB)
# CONSULTATION_EFFORT=medium
# RISK_EFFORT=medium
# EXTRACTION_EFFORT=high
# SCRIPT_EFFORT=medium
# CONSULTATION_SOFT_TURN_LIMIT=28
# CONSULTATION_HARD_TURN_LIMIT=36
